# =========================================================================
# GMAIL DASHBOARD - DEFINITIVE PRODUCTION CONFIGURATION TEMPLATE
# =========================================================================
# Copy this file to '.env' and fill in your credentials.
# Only operational dials are exposed; internal logic remains hardcoded.
# =========================================================================

# ---------- 🛡️ ZERO-BOT-SIGNATURE SAFEGUARDS ----------
# Global sync kill switch
SYNC_ENABLED=true

# Proactive rate limiting (Calls per minute per user)
GMAIL_CALLS_PER_MINUTE_LIMIT=50

# How often the background worker should check for mail (Seconds)
GMAIL_SYNC_INTERVAL_SECONDS=600

# Manual sync cooldown to prevent bot-like hammering (Seconds)
MANUAL_SYNC_COOLDOWN_SECONDS=60

# --- INITIAL SYNC DEPTH ---
# How many days of history to fetch on the first login (e.g., 14, 30, 90, 365)
GMAIL_FULL_SYNC_DAYS=365

# Anti-Bot Traffic Jitter (Random ± variance in seconds)
SYNC_JITTER_SECONDS=60

# Maximum Exponential Backoff (Seconds; e.g. 3600 = 1 hour)
SYNC_MAX_BACKOFF_SECONDS=3600

# ---------- 🔑 AI / LLM KEYS ----------
GOOGLE_API_KEY=your_google_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Dedicated keys for high-volume background tasks to isolate quotas
PRIORITY_GOOGLE_API_KEY=your_priority_google_api_key_here
PRIORITY_GEMINI_API_KEY=your_priority_gemini_api_key_here
CHATBOT_GEMINI_API_KEY=your_chatbot_gemini_api_key_here

# ---------- 🤖 AI MODEL CONFIGURATION ----------
AI_PREFER_LOCAL=false
PRIMARY_LOCAL_MODEL=gemma3:4b
OLLAMA_CONTEXT_LENGTH=16384
OLLAMA_VULKAN=1
OLLAMA_FLASH_ATTENTION=1
OLLAMA_GPU_OVERHEAD=100000000

# Comma-separated list of models for internal fallback logic.
# Preserves canonical order: ollama -> flash-lite -> gemma -> reasoning
AI_FALLBACK_MODELS=ollama/llama3.2:3b,ollama/qwen3.5:4b,ollama/gemma3:4b,ollama/phi4-mini:latest,models/gemini-3.1-flash-lite,models/gemini-flash-latest,models/gemini-3-flash-preview,models/gemini-2.5-flash-lite,models/gemma-4-31b-it,models/gemma-4-26b-a4b-it,models/gemma-3-27b-it,models/gemma-3-12b-it,models/gemma-3-4b-it,models/gemma-3n-e2b-it,models/gemma-3-1b-it,models/gemini-robotics-er-1.6-preview,models/gemini-robotics-er-1.5-preview

# Comma-separated list of vision models for scanning visual attachments
VISION_FALLBACK_MODELS=ollama/qwen3-vl:2b,ollama/qwen2-vl:2b,ollama/moondream,models/gemini-3.1-flash-lite,models/gemini-flash-latest,models/gemini-3-flash-preview,models/gemini-2.5-flash-lite

# ---------- 🔍 RAG & RETRIEVAL TUNING ----------
# Number of chunks to retrieve for context re-ranking
RAG_TOP_K=5

# Minimum semantic similarity score (0.0 to 1.0) to consider a clause relevant
RAG_MIN_SCORE=0.30
RAG_FINAL_LIMIT=3
# Max unique document sections to keep in context (0/negative to disable consistency filtering, 1 to keep dominant only, 2 for top two sections, etc.)
RAG_MAX_UNIQUE_SECTIONS=0

# --- SURGICAL RAG "3+2" CONFIGURATION ---
# The "3": Max unreplied citizen messages to include in context
RAG_UNREPLIED_MAX=3
# The "2": Anchor history interaction points (Dept Reply + Citizen Trigger)
RAG_ANCHOR_DEPTH=2
# Secondary semantic threshold for broader matches
RAG_SIMILARITY_THRESHOLD=0.30

# ---------- 🌐 SERVER / CORS CONFIG ----------
PORT=8000
APP_ENV=development
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000,http://127.0.0.1:3001
GOOGLE_OAUTH_COOKIE_SECURE=false

# ---------- 🔑 GOOGLE OAUTH CONFIGURATION ----------
GOOGLE_OAUTH_CLIENT_ID=your_oauth_client_id_here
GOOGLE_OAUTH_CLIENT_SECRET=your_oauth_client_secret_here
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/auth/google/callback
GOOGLE_OAUTH_ENCRYPTION_KEY=your_encryption_key_here
APP_SESSION_SECRET=your_app_session_secret_here
GOOGLE_OAUTH_SUCCESS_REDIRECT_URL=http://localhost:3000

# Cache & Maintenance Timers
CACHE_TTL_SECONDS=3600
CLEANUP_INTERVAL_SECONDS=60

# Optional Paths
GOOGLE_OAUTH_TOKEN_PATH=
GOOGLE_OAUTH_TOKENS_DIR=data/oauth_tokens

# ---------- 📊 PRIORITY LLM RATE LIMITING ----------
PRIORITY_LLM_MAX_CALLS=1
PRIORITY_LLM_WINDOW_SECONDS=60

# --- AI PROCESSING DENSITY ---
# How many emails for the AI to triage in a single request (10-20 recommended)
AI_BATCH_SIZE=15
# =========================================================================

# =========================================================
# AI / LLM KEYS (at least one is required)
# =========================================================
GOOGLE_API_KEY=your_google_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Optional dedicated keys for priority enrichment.
# If not set, background AI priority refinement will be skipped to avoid 
# saturating the main key quota for Chat/RAG.
PRIORITY_GOOGLE_API_KEY=your_dedicated_key_here
PRIORITY_GEMINI_API_KEY=

# Optional dedicated key for the Intelligent Chatbot.
# If not set, it will fallback to the main GOOGLE_API_KEY.
CHATBOT_GEMINI_API_KEY=

# Optional: Hugging Face token to reduce model download warnings/rate limits
HF_TOKEN=

# =========================================================
# SERVER / CORS
# =========================================================
PORT=8000
APP_ENV=development
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000,http://127.0.0.1:3001

# =========================================================
# DYNAMIC EMAIL FETCH (ONLY MODE)
# =========================================================
# Gmail mailbox that will be fetched dynamically by /process
GMAIL_ADDRESS=your-project@gmail.com

# =========================================================
# GOOGLE OAUTH (RECOMMENDED FOR EASY USER LOGIN)
# =========================================================
# Create OAuth client in Google Cloud Console and set redirect URI to:
# http://localhost:8000/auth/google/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/auth/google/callback

# Required for secure token storage. Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
GOOGLE_OAUTH_ENCRYPTION_KEY=

# Required for signing user session cookies in multi-user mode.
# You can reuse the same generation command above.
APP_SESSION_SECRET=

# Optional: redirect the callback back to your frontend after login
GOOGLE_OAUTH_SUCCESS_REDIRECT_URL=http://localhost:3000

# If true, OAuth state cookie is marked Secure and only sent over HTTPS.
# Set true in production behind HTTPS.
GOOGLE_OAUTH_COOKIE_SECURE=false

# Optional: token file path (default backend/data/google_oauth_token.enc)
GOOGLE_OAUTH_TOKEN_PATH=

# Optional: directory for per-user encrypted OAuth token files.
# Default: backend/data/oauth_tokens
GOOGLE_OAUTH_TOKENS_DIR=

# Legacy app-password support is disabled in production-secure mode.
# Leave empty.
GMAIL_APP_PASSWORD=

# IMAP/SMTP settings (defaults are Gmail)
GMAIL_IMAP_HOST=imap.gmail.com
GMAIL_IMAP_PORT=993
GMAIL_SMTP_HOST=smtp.gmail.com
GMAIL_SMTP_PORT=465

# Number of most recent emails to fetch from inbox.
# 0 means fetch all inbox emails.
DYNAMIC_FETCH_LIMIT=0

# Auto-refresh interval (seconds) for dynamic inbox cache used by /emails, /categories, /dashboard.
# Set 0 to disable cache and fetch on every request.
DYNAMIC_AUTO_REFRESH_SECONDS=30

# Whether to run background LLM refinement for priorities in dynamic mode.
# Initial request-time priorities are always heuristic and non-blocking.
DYNAMIC_USE_LLM_PRIORITY=false

# Priority LLM rate limiting: max attempts per rolling window.
# These calls are grouped into batches of 10 emails.
PRIORITY_LLM_MAX_CALLS=5
PRIORITY_LLM_WINDOW_SECONDS=300

# =========================================================
# DEMO / LEGACY SUPPORT FLAGS
# =========================================================
# Kept for compatibility with existing code paths/utilities
DEMO_USE_LLM_PRIORITY=false
DEMO_MODE=true

# =========================================================
# OPTIONAL RAG TUNING (kept for compatibility)
# =========================================================
RAG_TOP_K=5
RAG_CANDIDATE_POOL=5
RAG_OVERSAMPLE_LIMIT=20
RAG_MIN_FINAL_SCORE=0.20
RAG_RETRIEVAL_CONF_THRESHOLD=0.55
RAG_DEMO_RETRIEVAL_CONF_THRESHOLD=0.35

RAG_MAX_CHUNK_EMBED_TOKENS=420
RAG_EMBED_CACHE_SIZE=256
RAG_RETRIEVAL_CACHE_SIZE=256

RAG_MAX_CONTEXT_CHARS=15000
SENTENCE_SEMANTIC_THRESHOLD=0.60
MIN_SUPPORTED_SENTENCE_RATIO=0.60
MIN_TRUST_SCORE=0.62
RESPONSE_CACHE_SIZE=128
RAG_WARMUP=true

# Legacy model hint (generation currently chooses model in code)
GOOGLE_MODEL=gemini-2.5-flash

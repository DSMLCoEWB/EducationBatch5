# =========================================================================
# GMAIL DASHBOARD - DEFINITIVE PRODUCTION CONFIGURATION TEMPLATE
# =========================================================================
# Copy this file to '.env' and fill in your credentials.
# Only operational dials are exposed; internal logic remains hardcoded.
# =========================================================================

# ---------- 🛡️ ZERO-BOT-SIGNATURE SAFEGUARDS ----------
# Global sync kill switch
SYNC_ENABLED=true

# Proactive rate limiting (Calls per minute per user)
GMAIL_CALLS_PER_MINUTE_LIMIT=50

# How often the background worker should check for mail (Seconds)
GMAIL_SYNC_INTERVAL_SECONDS=600

# Manual sync cooldown to prevent bot-like hammering (Seconds)
MANUAL_SYNC_COOLDOWN_SECONDS=120

# --- INITIAL SYNC DEPTH ---
# How many days of history to fetch on the first login (e.g., 14, 30, 90)
GMAIL_FULL_SYNC_DAYS=14

# Anti-Bot Traffic Jitter (Random ± variance in seconds)
SYNC_JITTER_SECONDS=60

# Maximum Exponential Backoff (Seconds; e.g. 3600 = 1 hour)
SYNC_MAX_BACKOFF_SECONDS=3600

# ---------- 🔑 AI / LLM KEYS ----------
GOOGLE_API_KEY=your_key_here
GEMINI_API_KEY=your_key_here

# Dedicated keys for high-volume background tasks
PRIORITY_GOOGLE_API_KEY=
PRIORITY_GEMINI_API_KEY=
CHATBOT_GEMINI_API_KEY=

# ---------- 🤖 AI MODEL CONFIGURATION ----------
# Comma-separated list of models for internal fallback logic.
# Preserves canonical order: flash-lite -> flash-latest -> gemma -> robotics
AI_FALLBACK_MODELS=models/gemini-3.1-flash-lite-preview,models/gemini-flash-latest,models/gemini-3-flash-preview,models/gemini-2.5-flash-lite,models/gemma-4-31b-it,models/gemma-4-26b-a4b-it,models/gemma-3-27b-it,models/gemma-3-12b-it,models/gemma-3-4b-it,models/gemma-3n-e2b-it,models/gemma-3-1b-it,models/gemini-robotics-er-1.6-preview,models/gemini-robotics-er-1.5-preview

# ---------- 🔍 RAG & RETRIEVAL TUNING ----------

# Number of chunks to retrieve for context re-ranking
RAG_TOP_K=5

# Minimum semantic similarity score (0.0 to 1.0) to consider a clause relevant
RAG_MIN_SCORE=0.40
RAG_FINAL_LIMIT=3

# --- SURGICAL RAG "3+2" CONFIGURATION ---
# The "3": Max unreplied citizen messages to include in context
RAG_UNREPLIED_MAX=3
# The "2": Anchor history interaction points (Dept Reply + Citizen Trigger)
RAG_ANCHOR_DEPTH=2
# Secondary semantic threshold for broader matches
RAG_SIMILARITY_THRESHOLD=0.40

# ---------- 🌐 SERVER / CORS CONFIG ----------
PORT=8000
APP_ENV=development
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000,http://127.0.0.1:3001
GOOGLE_OAUTH_COOKIE_SECURE=false

# ---------- 🔑 GOOGLE OAUTH CONFIGURATION ----------
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/auth/google/callback
GOOGLE_OAUTH_ENCRYPTION_KEY=
APP_SESSION_SECRET=
GOOGLE_OAUTH_SUCCESS_REDIRECT_URL=http://localhost:3000

# Cache & Maintenance Timers
CACHE_TTL_SECONDS=3600
CLEANUP_INTERVAL_SECONDS=60



# ---------- 📊 PRIORITY LLM RATE LIMITING ----------
PRIORITY_LLM_MAX_CALLS=1
PRIORITY_LLM_WINDOW_SECONDS=60

# --- AI PROCESSING DENSITY ---
# How many emails for the AI to triage in a single request (10-20 recommended)
AI_BATCH_SIZE=15
# =========================================================================

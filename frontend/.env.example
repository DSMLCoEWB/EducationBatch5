# ===== Backend API URLs =====
# Development
# VITE_API_URL=http://localhost:8000
# VITE_REPLY_API_URL=http://localhost:8000

# Production (update with your actual backend domain)
VITE_API_URL=https://your-backend-domain.com
VITE_REPLY_API_URL=https://your-backend-domain.com

# UI Responsiveness
VITE_AUTH_STATUS_POLLING_SECONDS=60

# Developer / QA Override: Set true to force-display the "Load Demo PDFs" button in production builds.
# (By default, it is automatically hidden in production and only shown in local dev mode).
VITE_SHOW_DEMO_BUTTON=false

# ===== Backend API URLs =====
# With the Unified Domain Architecture (Master NGINX Gateway), the frontend and 
# backend are hosted on the exact same domain. 
# Therefore, use relative paths to eliminate CORS completely.
VITE_API_URL=/api
VITE_REPLY_API_URL=/api

# Optional: If you are running the frontend via `npm run dev` and your 
# local backend is NOT on port 8000 (or you want to proxy to a staging server),
# uncomment and set this variable. It is ignored in production builds.
# VITE_DEV_PROXY_TARGET=http://localhost:8000

# UI Responsiveness
VITE_AUTH_STATUS_POLLING_SECONDS=60

# Developer / QA Override: Set true to force-display the "Load Demo PDFs" button in production builds.
# (By default, it is automatically hidden in production and only shown in local dev mode).
VITE_SHOW_DEMO_BUTTON=false
